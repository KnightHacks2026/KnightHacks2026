# Optional path for the built-in SQLite dataset and local authentication store.
# The auth:setup command reads .env.local, so it provisions the same database as Next.js.
CUSTODYOS_DATABASE_PATH="data/custodyos.sqlite"
# Temporary owner for local/demo data until authenticated sessions are available.
CUSTODYOS_DEMO_USER_ID="demo-user"
# Owner identity assigned to pre-user-keyed SQLite records during compatibility reads.
CUSTODYOS_LEGACY_USER_ID="demo-user"
